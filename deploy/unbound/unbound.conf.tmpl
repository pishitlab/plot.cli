# Sandbox resolver (SPEC §7.2). Rendered by entrypoint.sh; forward-zones are appended.
server:
    verbosity: 1
    interface: 0.0.0.0
    port: 53
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes
    chroot: ""
    username: "unbound"
    directory: "/etc/unbound"
    logfile: ""
    use-syslog: no
    pidfile: ""

    # iterator only: no validator, no trust anchor (no DNSSEC, SPEC §1.3)
    module-config: "iterator"
    root-hints: "/etc/unbound/root.hints"
    qname-minimisation: no

    # the sandbox root delegates registrable names directly (D-005) and glue may be private
    harden-glue: no
    harden-referral-path: no
    harden-dnssec-stripped: no
    do-not-query-localhost: no
    # no private-address lines: glue such as 192.168.x.x must not be filtered

    access-control: 0.0.0.0/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: 10.0.0.0/8 allow
    access-control: 172.16.0.0/12 allow
    access-control: 192.168.0.0/16 allow

    cache-max-negative-ttl: 10
    cache-min-ttl: 0
    cache-max-ttl: ${CACHE_MAX_TTL}
    # forget unresponsive (lame) servers quickly so tests recover fast
    infra-host-ttl: 10

remote-control:
    control-enable: yes
    control-interface: 0.0.0.0
    control-port: 8953
    control-use-cert: no
